# ── Database ──
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://itdocs:itdocs@localhost:5433/itdocs

# ── App ──
APP_URL=https://itdocs.example.local
# Idle session timeout in minutes, absolute session lifetime in hours
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
# Set to false only for local http development
COOKIE_SECURE=true
UPLOAD_DIR=./data/uploads

# ── Password vault (Phase 3) ── 32 random bytes, base64. KEEP OUT OF BACKUPS OF THE DB.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_MASTER_KEY=

# ── Active Directory / LDAP ──
LDAP_ENABLED=true
LDAP_URL=ldaps://dc01.example.local:636
LDAP_BIND_DN=CN=svc-itdocs,OU=Service Accounts,DC=example,DC=local
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=DC=example,DC=local
# {{username}} is replaced (escaped) with what the user typed
LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={{username}}))
LDAP_USERNAME_ATTR=sAMAccountName
LDAP_DISPLAYNAME_ATTR=displayName
LDAP_EMAIL_ATTR=mail
# Extra group lookup ({{dn}} = user's DN). AD also exposes memberOf, which is always read.
LDAP_GROUP_BASE_DN=DC=example,DC=local
LDAP_GROUP_FILTER=(member={{dn}})
# Users not in any mapped group are refused
LDAP_REQUIRE_GROUP=true
# Set to false only if your DC uses a self-signed cert you cannot trust
LDAP_TLS_REJECT_UNAUTHORIZED=true

# ── Break-glass local admin (created by seed if absent) ──
BOOTSTRAP_ADMIN_USERNAME=breakglass
BOOTSTRAP_ADMIN_PASSWORD=
