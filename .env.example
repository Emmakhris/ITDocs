# ── Database ──
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://itdocs:itdocs@localhost:5433/itdocs

# ── App ──
APP_URL=https://itdocs.example.local
# Idle session timeout in minutes, absolute session lifetime in hours
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
# Set to false only for local http development
COOKIE_SECURE=true
UPLOAD_DIR=./data/uploads

# ── Password vault ── 32 random bytes, base64. KEEP OUT OF BACKUPS OF THE DB.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_MASTER_KEY=
# Only during key rotation: previous key(s), comma-separated, decrypt-only. See scripts/vault-rotate-key.ts
VAULT_OLD_MASTER_KEYS=

# ── Active Directory / LDAP ──
LDAP_ENABLED=true
LDAP_URL=ldaps://dc01.example.local:636
LDAP_BIND_DN=CN=svc-itdocs,OU=Service Accounts,DC=example,DC=local
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=DC=example,DC=local
# {{username}} is replaced (escaped) with what the user typed
LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={{username}}))
LDAP_USERNAME_ATTR=sAMAccountName
LDAP_DISPLAYNAME_ATTR=displayName
LDAP_EMAIL_ATTR=mail
# Extra group lookup ({{dn}} = user's DN). AD also exposes memberOf, which is always read.
LDAP_GROUP_BASE_DN=DC=example,DC=local
LDAP_GROUP_FILTER=(member={{dn}})
# Users not in any mapped group are refused
LDAP_REQUIRE_GROUP=true
# Set to false only if your DC uses a self-signed cert you cannot trust
LDAP_TLS_REJECT_UNAUTHORIZED=true

# ── Alerts (Admin › Alerts sets recipients and timing) ──
# Email. Leave SMTP_HOST empty to disable; SMTP_HOST=log records messages without sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ITDocs <itdocs@example.local>
# Microsoft Teams: URL of a Workflows "post to a channel when a webhook request is received" flow (or incoming webhook)
TEAMS_WEBHOOK_URL=
# The in-app scheduler (daily digest, scheduled reports). Set to off on extra instances if you like.
ALERTS_SCHEDULER=on
# Time zone used for change windows, the digest hour and day boundaries in the journal
TZ=Europe/London

# ── Break-glass local admin (created by seed if absent) ──
BOOTSTRAP_ADMIN_USERNAME=breakglass
BOOTSTRAP_ADMIN_PASSWORD=
